{
  "name": "dashboard-app",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
  "build:client": "tsc -p tsconfig.client.json && robocopy public dist\\public /E /XD server /XF *.ts",
  "build:server": "tsc -p tsconfig.server.json",
  "build": "npm run build:client && npm run build:server",
  "start": "node dist/server/index.js",
  "dev": "ts-node-dev --respawn --transpile-only --project tsconfig.server.json server/index.ts"
},
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.36.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.25",
    "@types/pg": "^8.15.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "20.x"
  }
}
